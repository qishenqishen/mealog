{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mealog",
  "account_id": "98475073d3ce478c3b7fd87f9613c2db",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "tsconfig": "worker/tsconfig.json",
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "INSIGHTS_QUOTA", "class_name": "InsightsQuota" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InsightsQuota"] }],
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
